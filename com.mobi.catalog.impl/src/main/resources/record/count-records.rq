PREFIX dc: <http://purl.org/dc/terms/>
PREFIX mcat: <http://mobi.com/ontologies/catalog#>

SELECT
    (COUNT(distinct ?record) as ?record_count)
WHERE {
    ?record a ?type ;
        mcat:catalog ?catalog .

    %RECORDS_FILTER%
    %KEYWORDS_FILTER%
    %CREATORS_FILTER%
    FILTER(?type IN (%RECORD_TYPE_FILTER%))
    %SEARCH_FILTER%
}
